# Copy to .env and adjust as needed. .env is gitignored.

NODE_ENV=development

# Port the API listens on (client → :5173, realtime server → :2567).
PORT=4000

# Origin allowed by CORS — the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection. Matches the credentials in docker-compose.yml; swap this
# one line for a managed Postgres (Neon, Supabase, …) with no code changes.
DATABASE_URL=postgres://nook:nook@localhost:5432/nook
