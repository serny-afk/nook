{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "skipLibCheck": true,

    /* Bundler-agnostic, single source of truth for the wire format */
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Colyseus schema (state.ts) declares synced fields with legacy decorators;
       these are not erasable, so erasableSyntaxOnly is intentionally off here. */
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
