# Client build-time config. Copy to `.env` only to override the localhost dev
# defaults (see src/config/env.ts) — local development works without this file.
# Vite exposes only VITE_-prefixed vars to the browser, inlined at build time.

# Colyseus realtime server (websocket). Use wss:// in production.
VITE_SERVER_URL=ws://localhost:2567

# REST / persistence API base URL. Use https:// in production.
VITE_API_URL=http://localhost:4000
